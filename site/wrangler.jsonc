{
  // 루트 wrangler.jsonc 와 같은 Worker(stock-analysis, 화면 + 시세 프록시 통합) 설정 — Git 연결 시 Root directory 를 "site" 로 둔 경우용입니다.
  // 루트 설정과 내용을 같게 유지하세요(경로만 ../ 기준). 이 설정만 쓰이면 프록시가 빠진 채 배포되는 일이 없도록 main 을 포함합니다.
  "name": "stock-analysis",
  "main": "../worker/index.js",
  "compatibility_date": "2025-01-01",
  "assets": {
    "directory": "../docs",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "ALLOWED_ORIGIN": "*"
  },
  "previews": {
    "vars": {
      "ALLOWED_ORIGIN": "https://jybs7411.github.io"
    }
  }
}
